index 0000000000000000000000000000000000000000..abe2f7dd2c93d8d087375c67393d4fb06eea3aaa
--- /dev/null
+++ b/lib/assert-depth.js
@@ -0,0 +1,16 @@
+'use strict';
+
+// Local mitigation for GHSA-vfj7-8cjw-p6xm. Walk iteratively before recursion,
+// including caller-supplied ASTs, without following parser parent/prev links.
+module.exports = ast => {
+  const pending = [[ast, 0]];
+  while (pending.length) {
+    const [node, depth] = pending.pop();
+    if (depth > 100) {
+      throw new SyntaxError('Brace pattern nesting exceeds maximum depth (100)');
+    }
+    if (node && Array.isArray(node.nodes)) {
+      for (const child of node.nodes) pending.push([child, depth + 1]);
+    }
+  }
+};
