# Local showcase configuration only. Never point this file at production.
POSTGRES_DB=homestay_demo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<YOUR_LOCAL_DATABASE_PASSWORD>
DATABASE_URL=postgresql+asyncpg://postgres:<YOUR_LOCAL_DATABASE_PASSWORD>@db:5432/homestay_demo
REDIS_URL=redis://redis:6379/0
APP_ENV=development
DEBUG=false
SECRET_KEY=<YOUR_LOCAL_SECRET_KEY>
JWT_SECRET_KEY=<YOUR_LOCAL_JWT_SECRET_KEY>
NEXT_PUBLIC_API_URL=/api/v1
BACKEND_URL=http://backend:8000
